+class FakeRuntimeState:
+    def session_status(self) -> dict[str, object]:
+        return {
+            "available_session_count": 3,
+            "loaded_session_count": 1,
+            "loaded_sessions": ["prefill"],
+        }
+
+
+class FakeOnnxRuntime:
+    def __init__(
+        self,
+        *,
+        thread_count: int = 4,
+        execution_provider: str = "cpu",
+        runtime: FakeRuntimeState | None = None,
+    ) -> None:
+        self.thread_count = thread_count
+        self.execution_provider = execution_provider
+        if runtime is not None:
+            self.runtime = runtime
+
+
+class FakeCodecStreamingSession:
+    def __init__(self, runtime: "FakeStreamingRuntime") -> None:
+        self.runtime = runtime
+        self._thread_state = threading.local()
+
+    def reset(self) -> None:
+        reset_count = int(getattr(self._thread_state, "reset_count", 0)) + 1
+        self._thread_state.reset_count = reset_count
+        if reset_count == 2:
+            self.runtime.cleanup_started.set()
+            self.runtime.allow_cleanup.wait(timeout=2.0)
+            self.runtime.cleanup_complete.set()
+
+    def run_frames(self, frames: list[list[int]]) -> tuple[np.ndarray, int] | None:
+        if not frames:
+            return None
+        audio_length = 960
+        return np.full((1, 2, audio_length), 0.01, dtype=np.float32), audio_length
+
+
+class FakeStreamingRuntime:
+    def __init__(self, *, block_after_first_frame: bool = False, gate_cleanup: bool = False) -> None:
+        self.codec_meta = {"codec_config": {"sample_rate": 48000, "channels": 2}}
+        self.codec_streaming_session = FakeCodecStreamingSession(self)
+        self.block_after_first_frame = block_after_first_frame
+        self.allow_generation = threading.Event()
+        if not block_after_first_frame:
+            self.allow_generation.set()
+        self.allow_cleanup = threading.Event()
+        if not gate_cleanup:
+            self.allow_cleanup.set()
+        self.cleanup_started = threading.Event()
+        self.cleanup_complete = threading.Event()
+        self.generation_exited = threading.Event()
+        self._active_lock = threading.Lock()
+        self.active_generations = 0
+        self.generation_entries = 0
+        self.overlap_detected = False
+
+    def resolve_prompt_audio_codes(self, *, voice: str | None, prompt_audio_path: str | None) -> list[int]:
+        del voice, prompt_audio_path
+        return [1]
+
+    def split_voice_clone_text(self, text: str, *, max_tokens: int) -> list[str]:
+        del max_tokens
+        return [text]
+
+    def encode_text(self, text: str) -> list[int]:
+        del text
+        return [1]
+
+    def build_voice_clone_request_rows(
+        self,
+        prompt_audio_codes: list[int],
+        text_token_ids: list[int],
+    ) -> dict[str, list[list[int]]]:
+        del prompt_audio_codes, text_token_ids
+        return {"inputIds": [[1]], "attentionMask": [[1]]}
+
+    def generate_audio_frames(self, request_rows: object, *, on_frame: object) -> list[list[int]]:
+        del request_rows
+        callback = on_frame
+        with self._active_lock:
+            self.active_generations += 1
+            self.generation_entries += 1
+            if self.active_generations > 1:
+                self.overlap_detected = True
+        frames: list[list[int]] = []
+        try:
+            for step_index in range(10000):
+                frame = [step_index]
+                frames.append(frame)
+                callback(frames, step_index, frame)  # type: ignore[operator]
+                if step_index == 0:
+                    self.allow_generation.wait(timeout=2.0)
+                time.sleep(0.001)
+            return frames
+        finally:
+            with self._active_lock:
+                self.active_generations -= 1
+            self.generation_exited.set()
+
+
+def build_streaming_adapter(runtime: FakeStreamingRuntime, output_dir: Path) -> app_onnx.OnnxNanoTTSServiceAdapter:
+    adapter = object.__new__(app_onnx.OnnxNanoTTSServiceAdapter)
+    adapter.runtime = runtime  # type: ignore[assignment]
+    adapter.output_dir = output_dir
+    adapter.thread_count = 4
+    adapter.execution_provider = "cpu"
+    adapter._resolve_sample_mode = lambda _requested, *, do_sample: "fixed"  # type: ignore[method-assign]
+    adapter._apply_generation_options = lambda **_kwargs: None  # type: ignore[method-assign]
+    adapter._format_result_payload = lambda **kwargs: kwargs  # type: ignore[method-assign]
+    return adapter
+
+
+def start_fake_stream(
