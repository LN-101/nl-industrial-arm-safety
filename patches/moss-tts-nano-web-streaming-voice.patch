+class LazyOrtSessionStore:
+    def __init__(self, factories: dict[str, Callable[[], ort.InferenceSession]]) -> None:
+        self._factories = dict(factories)
+        self._sessions: dict[str, ort.InferenceSession] = {}
+        self._lock = threading.Lock()
