+        text="测试中断",
+        mode="voice_clone",
+        voice="Xiaoyu",
+        prompt_audio_path=None,
+        max_new_frames=100,
+        voice_clone_max_text_tokens=75,
+        cancel_event=cancel_event,
+    )
