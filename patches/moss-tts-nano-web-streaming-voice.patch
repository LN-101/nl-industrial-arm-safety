+            if factory is None:
+                raise KeyError(key)
+            session = factory()
+            self._sessions[key] = session
+            return session
+
+    def available_keys(self) -> list[str]:
+        return sorted(self._factories)
+
+    def loaded_keys(self) -> list[str]:
+        with self._lock:
+            return sorted(self._sessions)
+
+    def loaded_count(self) -> int:
+        with self._lock:
