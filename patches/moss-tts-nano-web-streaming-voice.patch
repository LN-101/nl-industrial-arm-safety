+class OnnxStreamingCancellationTest(unittest.TestCase):
+    def test_closing_after_first_audio_joins_inner_worker_and_cleans_codec_state(self) -> None:
+        with tempfile.TemporaryDirectory() as temp_dir:
+            runtime = FakeStreamingRuntime()
+            adapter = build_streaming_adapter(runtime, Path(temp_dir))
+            stream = start_fake_stream(adapter)
+
+            first_event = next(stream)
+            stream.close()
+
+        self.assertEqual(first_event["type"], "audio")
+        self.assertTrue(runtime.generation_exited.wait(timeout=1.0))
+        self.assertTrue(runtime.cleanup_complete.wait(timeout=1.0))
+        self.assertFalse(any(thread.name == "onnx-synthesize-stream" for thread in threading.enumerate()))
+
+    def test_repeated_cancellation_does_not_leak_worker_threads(self) -> None:
+        baseline = sum(thread.name == "onnx-synthesize-stream" for thread in threading.enumerate())
+        with tempfile.TemporaryDirectory() as temp_dir:
+            for _ in range(8):
+                runtime = FakeStreamingRuntime()
+                adapter = build_streaming_adapter(runtime, Path(temp_dir))
+                stream = start_fake_stream(adapter)
+                self.assertEqual(next(stream)["type"], "audio")
+                stream.close()
+                self.assertTrue(runtime.cleanup_complete.wait(timeout=1.0))
+
+        remaining = sum(thread.name == "onnx-synthesize-stream" for thread in threading.enumerate())
+        self.assertEqual(remaining, baseline)
+
+    def test_execution_lock_is_held_until_canceled_worker_cleanup_finishes(self) -> None:
+        with tempfile.TemporaryDirectory() as temp_dir:
+            runtime = FakeStreamingRuntime(gate_cleanup=True)
+            adapter = build_streaming_adapter(runtime, Path(temp_dir))
+            manager = app_onnx.OnnxRequestRuntimeManager(adapter)
+            first_stream = manager.iter_with_runtime(
+                requested_execution_device="cpu",
+                cpu_threads=4,
+                factory=lambda selected: start_fake_stream(selected),
+            )
+            self.assertEqual(next(first_stream)[0]["type"], "audio")
+
+            second_stream_holder: list[object] = []
+            second_audio = threading.Event()
+
+            def _consume_second() -> None:
+                second_stream = manager.iter_with_runtime(
+                    requested_execution_device="cpu",
+                    cpu_threads=4,
+                    factory=lambda selected: start_fake_stream(selected),
+                )
+                second_stream_holder.append(second_stream)
+                next(second_stream)
+                second_audio.set()
+
+            second_thread = threading.Thread(target=_consume_second, daemon=True)
+            second_thread.start()
+            close_thread = threading.Thread(target=first_stream.close, daemon=True)
+            close_thread.start()
+
+            self.assertTrue(runtime.cleanup_started.wait(timeout=1.0))
+            self.assertEqual(runtime.generation_entries, 1)
+            self.assertFalse(second_audio.is_set())
+            runtime.allow_cleanup.set()
+            close_thread.join(timeout=1.0)
+            self.assertFalse(close_thread.is_alive())
+            self.assertTrue(second_audio.wait(timeout=1.0))
+            self.assertEqual(runtime.generation_entries, 2)
+            self.assertFalse(runtime.overlap_detected)
+            second_thread.join(timeout=1.0)
+            second_stream_holder[0].close()  # type: ignore[attr-defined]
+
+    def test_worker_timeout_marks_shared_runtime_unusable(self) -> None:
+        with tempfile.TemporaryDirectory() as temp_dir:
