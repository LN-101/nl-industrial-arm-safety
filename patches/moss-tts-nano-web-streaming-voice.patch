+class OnnxRequestRuntimeManagerTest(unittest.TestCase):
+    def test_call_with_runtime_reuses_startup_runtime_for_any_request_threads(self) -> None:
+        runtime = FakeOnnxRuntime(thread_count=4)
+        manager = app_onnx.OnnxRequestRuntimeManager(runtime)  # type: ignore[arg-type]
+
+        with patch.object(app_onnx, "OnnxNanoTTSServiceAdapter", side_effect=AssertionError("unexpected runtime build")):
+            result, execution_device, resolved_threads = manager.call_with_runtime(
+                requested_execution_device="cpu",
+                cpu_threads=99,
+                callback=lambda selected_runtime: selected_runtime,
+            )
+
+        self.assertIs(result, runtime)
+        self.assertEqual(execution_device, "cpu")
+        self.assertEqual(resolved_threads, 4)
+        self.assertEqual(manager.runtime_count(), 1)
+        self.assertEqual(manager.loaded_runtime_threads(), [4])
+
+    def test_iter_with_runtime_preserves_streaming_iteration(self) -> None:
+        runtime = FakeOnnxRuntime(thread_count=6)
+        manager = app_onnx.OnnxRequestRuntimeManager(runtime)  # type: ignore[arg-type]
+
+        def factory(selected_runtime: FakeOnnxRuntime):
+            self.assertIs(selected_runtime, runtime)
+            yield {"type": "audio", "index": 0}
+            yield {"type": "audio", "index": 1}
+
+        with patch.object(app_onnx, "OnnxNanoTTSServiceAdapter", side_effect=AssertionError("unexpected runtime build")):
+            events = list(
+                manager.iter_with_runtime(
+                    requested_execution_device="cpu",
+                    cpu_threads=0,
+                    factory=factory,
+                )
+            )
+
+        self.assertEqual(
+            events,
+            [
+                ({"type": "audio", "index": 0}, "cpu", 6),
+                ({"type": "audio", "index": 1}, "cpu", 6),
+            ],
+        )
+
+    def test_status_reports_single_shared_runtime(self) -> None:
+        runtime = FakeOnnxRuntime(thread_count=4)
